{
  "name": "finflow",
  "version": "1.5.1",
  "private": true,
  "description": "Личный финансовый помощник FinFlow",
  "scripts": {
    "build:css": "tailwindcss -c ./tailwind.config.cjs -i ./tailwind.input.css -o ./tailwind.generated.css --minify",
    "test": "node --test",
    "check": "npm run build:css && node --check core.js && node --check app.js && node --check sw.js && node --check scripts/serve.mjs && npm test",
    "preview": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
